{
  "name": "Cátodo Remote",
  "short_name": "Cátodo",
  "description": "Control remoto de Cátodo desde el celular",
  "start_url": "/remote/",
  "scope": "/remote/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#1db954",
  "icons": [
    { "src": "/remote/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/remote/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/remote/icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
