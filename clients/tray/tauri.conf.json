{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catodo Tray",
  "version": "0.1.0",
  "identifier": "ai.catodo.tray",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "label": "pair",
        "title": "Cátodo · Emparejar",
        "url": "index.html",
        "width": 420,
        "height": 540,
        "resizable": false,
        "decorations": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Cátodo system tray",
    "longDescription": "Persistent OS tray menu to control the Cátodo kiosk (modes, play/pause, volume, deep link to /remote)."
  },
  "plugins": {}
}