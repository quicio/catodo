{
  "name": "catodo-frontend",
  "private": true,
  "version": "0.4.4",
  "description": "Cátodo desktop shell",
  "author": {
    "name": "Cátodo Project",
    "email": "[email protected]"
  },
  "homepage": "https://example.com/catodo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "electron:dev": "bash ../run-dev.sh",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux AppImage deb",
    "electron:build:mac": "vite build && electron-builder --mac zip",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "lucide": "^1.28.0",
    "lucide-react": "^1.28.0",
    "morphicons": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "https://github.com/castlabs/electron-releases/archive/refs/tags/v45.2.1+wvcus.tar.gz",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "dev.catodo.frontend",
    "productName": "Catodo",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "es"
    ],
    "npmRebuild": false,
    "artifactName": "Catodo-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,LICENSE,license,License,*.md}"
    ],
    "extraResources": [
      {
        "from": "backend-bundle",
        "to": "backend"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../catodo.png",
      "category": "AudioVideo"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "../catodo.png",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "CFBundleDisplayName": "Cátodo"
      }
    }
  }
}
