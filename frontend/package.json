{
  "name": "catodo-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Cátodo desktop shell",
  "author": {
    "name": "Cátodo Project",
    "email": "[email protected]"
  },
  "homepage": "https://example.com/catodo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "bash ../run-dev.sh",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "lucide": "^1.28.0",
    "lucide-react": "^1.28.0",
    "morphicons": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "dev.catodo.frontend",
    "productName": "Cátodo",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../catodo.png",
      "category": "AudioVideo"
    }
  }
}
